+/**
+**  Delete the orders a unit keeps outside its order queue.
+**
+**  SavedOrder/NewOrder/CriticalOrder hold references (a harvest order even
+**  references its own worker). Left on a dead unit they keep it referenced
+**  forever, and freeing them after the unit itself is freed is a double free.
+*/
+static void ClearPendingOrders(CUnit &unit)
+{
+	if (unit.SavedOrder != NULL) {
+		COrder *order = unit.SavedOrder;
+		unit.SavedOrder = NULL;
+		delete order;
+	}
+	if (unit.NewOrder != NULL) {
+		COrder *order = unit.NewOrder;
+		unit.NewOrder = NULL;
+		delete order;
+	}
+	if (unit.CriticalOrder != NULL) {
+		COrder *order = unit.CriticalOrder;
+		unit.CriticalOrder = NULL;
+		delete order;
+	}
+}
+
 void LetUnitDie(CUnit &unit, bool suicide)
 {
+	ClearPendingOrders(unit);
 	unit.Variable[HP_INDEX].Value = std::min<int>(0, unit.Variable[HP_INDEX].Value);
 	unit.Moving = 0;
